# Copy to infra/azure/.env.azure and fill in. That file is gitignored.
# deploy.sh sources this and pushes the values into Container Apps secrets, so
# it never needs to live inside the image.

# ── Required ───────────────────────────────────────────────────────────────────
# Host comes from the deploy.sh output. sslmode=no-verify is REQUIRED: pg 8.21
# treats `require` as strict verify-full, and Azure's cert chain fails that.
DATABASE_URL=postgresql://fopsadmin:<password>@fops-pulse-pg.postgres.database.azure.com:5432/fops_pulse?sslmode=no-verify

# Generate with: openssl rand -base64 48
# server.js falls back to a hardcoded literal if this is unset - anyone reading
# the repo could then forge a session cookie. Never deploy without it.
SESSION_SECRET=

# ── LLM providers ──────────────────────────────────────────────────────────────
GROQ_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# ── Data sources ───────────────────────────────────────────────────────────────
WEATHER_API_KEY=
OPEN_EXCHANGE_APP_ID=

# ── Microsoft Entra SSO (optional; omit for password login only) ──────────────
# Do NOT set ENTRA_REDIRECT_URI here - deploy.sh derives it from the live
# Container Apps FQDN, because the value in the repo's .env.example still points
# at onrender.com.
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_AUTHORITY=https://drizzla.ciamlogin.com/0970e5ef-2f6d-485e-a375-ae65387a0fd3/v2.0
ENTRA_ALLOWED_EMAIL_DOMAINS=drizzla.com,aramtec.com
ENTRA_ALLOWED_TENANT_IDS=
ENTRA_ADMIN_EMAILS=

# ── Tuning ─────────────────────────────────────────────────────────────────────
DB_CONNECT_TIMEOUT_MS=15000

# Background schedulers. Leave false for the first deploy: turn them on only
# once /readyz is green, so a scheduler crash loop cannot mask a bad rollout.
ENABLE_BACKGROUND_AI=false
ENABLE_USER_SCANNER=false
ENABLE_GEO_SCANNER=false
