# Copy to .env and fill in real values. NEVER commit .env — it is gitignored.

# --- Database ---
DATABASE_URL=postgresql://user:password@localhost:5432/fops_pulse

# --- Security (required in production) ---
SESSION_SECRET=generate-a-long-random-string

# --- LLM providers ---
# GROQ_API_KEY accepts a single key or a comma-separated pool for failover.
# NOTE: the pool only rotates on RATE LIMITS, and only across keys — there is
# no fallback to a smaller model or another provider. With one key there is no
# failover at all.
GROQ_API_KEY=
GEMINI_API_KEY=

# Models are env-overridable because providers decommission them without much
# notice, and a 404 takes the feature down until config changes.
# Run `npm run check:models` to verify these exist on your key AND honour
# JSON mode before deploying.
# GROQ_MODEL_REASONING=openai/gpt-oss-120b   # planner + deep dive
# LABELING_GROQ_MODEL=openai/gpt-oss-20b     # article summaries

# Hard ceiling on any single LLM HTTP call (ms). Without it a hung provider
# socket pins an Express request open indefinitely.
# LLM_TIMEOUT_MS=45000

# --- Data sources ---
WEATHER_API_KEY=
OPEN_EXCHANGE_APP_ID=

# --- Email alerts (optional) ---
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SENDER_EMAIL=

# --- Optional feature flags ---
# ENABLE_BACKGROUND_AI=false
# ENABLE_USER_SCANNER=false
# Allows services/signals/news_extractor.js to write SIMULATED (non-LLM)
# keyword signals into market_signals. Off by default: the recommendations
# engine reads that table, so mock rows would seed real recommendations.
# ALLOW_MOCK_SIGNALS=false
