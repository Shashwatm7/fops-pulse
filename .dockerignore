# Dependencies — reinstalled from lockfiles inside the image.
node_modules
dashboard/node_modules

# VCS / local tooling
.git
.gitignore
.github

# Secrets. The runtime stage uses explicit COPYs so these could not reach it
# anyway, but the builder does `COPY . .` and its layers are still readable in
# the registry — keep them out entirely.
.env
.env.*
**/.env
**/.env.*
!.env.example
infra/azure/.env.azure
*.pem
*.key

# Build output — regenerated by the builder stage. Copying a stale local dist
# in would let it shadow the fresh build.
dashboard/dist

# Local runtime state, not deployable content.
data-archive
*.log
*.sqlite
*.sqlite3
*.db

# Docs, mockups, and scratch files
docs
Dockerfile.bak
README.md
